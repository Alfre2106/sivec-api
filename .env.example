# === Configuración de SIVEC API ===
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# --- Entorno de Flask ---
# Punto de entrada para el CLI de Flask (flask db, flask seed, flask routes)
FLASK_APP=run.py
# Valores: development | testing | production
FLASK_ENV=development
# Dirección y puerto donde escucha la API (python run.py).
# Por defecto solo este equipo (127.0.0.1). Usa 0.0.0.0 solo si otros equipos de la
# red deben acceder a la API; en ese caso usa FLASK_ENV=production (sin depurador).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Clave secreta de la aplicación (cadena larga y aleatoria; en producción es obligatoria)
SECRET_KEY=cambia-esta-clave-secreta

# --- Base de datos PostgreSQL ---
# Formato: postgresql+psycopg2://usuario:contrasena@host:puerto/nombre_bd
# Si la contraseña tiene caracteres especiales (@ : / #), escríbela codificada
# en formato URL (por ejemplo @ -> %40).
DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/sivec
# Base EXCLUSIVA para las pruebas automáticas (pytest). Debe ser distinta de
# DATABASE_URL y su nombre debe incluir "test". Las pruebas BORRAN sus datos.
TEST_DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/sivec_test

# --- JWT (autenticación) ---
# Clave para firmar los tokens (distinta de SECRET_KEY; en producción es obligatoria)
JWT_SECRET_KEY=cambia-esta-clave-jwt
# Expiración del token de acceso en minutos
JWT_EXPIRACION_MINUTOS=120

# --- CORS ---
# Origen(es) del frontend permitido(s), separados por coma
CORS_ORIGENES=http://localhost:5173,http://localhost:3000

# --- Reglas de negocio ---
# Duración de una reserva en minutos (RN-03)
RESERVA_DURACION_MINUTOS=5
# Máximo de asientos por solicitud de reserva
MAX_ASIENTOS_POR_RESERVA=8
# Máximo de reservas activas por usuario en una misma función
MAX_RESERVAS_ACTIVAS_POR_FUNCION=8
# Cada cuántos segundos el scheduler libera las reservas vencidas
SCHEDULER_INTERVALO_SEGUNDOS=30
# Minutos de anticipación para validar una entrada antes del inicio de la función
VALIDACION_ANTICIPACION_MINUTOS=120
# Zona horaria de negocio (las fechas se guardan en UTC)
ZONA_HORARIA=America/Bogota
